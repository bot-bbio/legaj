# Binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
/legaj

# Build output. Narrow on purpose: build/windows/ (icon, manifest, version
# info) and frontend/dist/.gitkeep must stay tracked so a clean checkout builds.
/dist/
/build/bin/
/build/legaj-tools/
/packaging/dist/
/packaging/staging/
*.app/
*.dmg

# Frontend
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
# Generated from Go by `wails generate module` on every verify/build.
frontend/wailsjs/

# Code-signing material (NEVER commit certificates or keys)
*.pfx
*.cer
*.p12

# Python cache & virtualenv
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Local configuration & secrets
.env
credentials.json
token.json

# Local job tracker data & PII (to prevent leaking personal applications)
references/job-tracker.xlsx
references/job-tracker.json
references/user-profile.json
references/user-profile-tailored.json
references/.clip_port
references/.clip_token
references/clipped-jobs.json
outputs/

# Browser extension files — auto-generated at startup, contain the session token
extension/content.js
extension/background.js
extension/manifest.json

# AI instruction docs (never commit)
legac docs new.md
new requirements.md

# Planning & task-tracking docs (local only)
\# Final Production to do list.md

# Security audit & plan — never commit
SECURITY_AUDIT.md
SECURITY_IMPLEMENTATION_PLAN.md

# OS specific files
.DS_Store
Thumbs.db
scratch/

# Internal workflow harness (never commit)
.claude/
skills/

# Internal planning & task docs (local only)
REFINEMENT_PLAN.md
final_tweaks.md
implementation.md
game breaking bugs.md
game_breaking_bugs_implementation_plan.md
Tab Merge.md

# Build & runtime logs
*.log
build_run.log

# Debug screenshots
error*.png
error*.PNG

# Runtime data logs
references/*.log

# Workspace harness & planning (local only, by workspace mandate)
.agent/
.workflow/
conductor/
STRATEGY.md
WORKFLOW.md
bootstrap.ps1
mach.exe
